{
  "name": "temple-fund-management",
  "version": "1.0.0",
  "description": "Temple Treasury, Expense Claim, Admin Approval & Audit Portal",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client",
    "dev": "concurrently \"node server/server.js\" \"npm run dev --prefix client\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  }
}
